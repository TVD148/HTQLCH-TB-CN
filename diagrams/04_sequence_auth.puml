@startuml 04_sequence_auth
!theme cerulean-outline
title Sơ đồ Tuần tự - Xác thực người dùng (JWT)\nĐăng ký & Đăng nhập & Cập nhật hồ sơ

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam sequenceParticipant underline

actor "Người dùng" as U #LightGreen
participant "React\nFrontend" as FE #LightBlue
participant "Auth\nController" as AUTH #LightYellow
participant "JWT\nMiddleware" as JWT #Orange
participant "MySQL\nDatabase" as DB #LightCoral

== ĐĂNG KÝ TÀI KHOẢN ==
U -> FE : Nhập name, email, password, phone
activate FE
FE -> FE : Validate form (client-side)
FE -> AUTH : POST /api/auth/register\n{name, email, password, phone}
activate AUTH

AUTH -> DB : SELECT ma_nguoi_dung FROM nguoi_dung\nWHERE email = ?
activate DB
DB --> AUTH : Result
deactivate DB

alt Email đã tồn tại
  AUTH --> FE : 409 { message: "Email đã được sử dụng" }
  FE --> U : Hiển thị lỗi "Email đã tồn tại"
else Email hợp lệ
  AUTH -> AUTH : Tách name → ho / ten_dem / ten
  AUTH -> AUTH : bcrypt.hash(password, 10)
  AUTH -> DB : INSERT INTO nguoi_dung\n(ho_ten, ho, ten_dem, ten, email,\n mat_khau_ma_hoa, so_dien_thoai)
  activate DB
  DB --> AUTH : { insertId: userId }
  deactivate DB
  AUTH -> DB : INSERT INTO gio_hang (ma_nguoi_dung)
  AUTH -> DB : INSERT INTO thong_bao\n(userId, "Chào mừng đến TechStore! 🎉")
  AUTH -> JWT : jwt.sign({id, role, email}, SECRET\n{expiresIn: '7d'})
  activate JWT
  JWT --> AUTH : accessToken
  deactivate JWT
  AUTH --> FE : 201 { token, user:{id,name,email,role} }
  FE -> FE : localStorage.setItem('token', token)
  FE -> FE : AuthContext.setUser(user)
  FE --> U : Redirect → Trang chủ\n"Đăng ký thành công! 🎉"
end
deactivate AUTH
deactivate FE

== ĐĂNG NHẬP ==
U -> FE : Nhập email + password
activate FE
FE -> AUTH : POST /api/auth/login\n{email, password}
activate AUTH

AUTH -> DB : SELECT * FROM nguoi_dung\nWHERE email = ?
activate DB
DB --> AUTH : User record (hoặc null)
deactivate DB

alt Không tìm thấy user
  AUTH --> FE : 401 { message: "Email hoặc mật khẩu không đúng" }
  FE --> U : Hiển thị lỗi
else User tồn tại nhưng bị khóa
  AUTH --> FE : 403 { message: "Tài khoản đã bị khóa" }
  FE --> U : Hiển thị lỗi tài khoản bị khóa
else User hợp lệ
  AUTH -> AUTH : bcrypt.compare\n(password, mat_khau_ma_hoa)
  alt Sai mật khẩu
    AUTH --> FE : 401 { message: "Email hoặc mật khẩu không đúng" }
    FE --> U : Hiển thị lỗi
  else Mật khẩu đúng
    AUTH -> JWT : jwt.sign\n({id, role, email}, SECRET, {expiresIn:'7d'})
    activate JWT
    JWT --> AUTH : accessToken
    deactivate JWT
    AUTH -> DB : UPDATE nguoi_dung SET ngay_cap_nhat=NOW()
    AUTH --> FE : 200 { token, user }
    FE -> FE : localStorage.setItem('token', token)
    FE -> FE : AuthContext.login(user)
    FE --> U : Redirect theo role:\n• admin/staff → /admin\n• user → /
  end
end
deactivate AUTH
deactivate FE

== CẬP NHẬT HỒ SƠ (Họ / Tên đệm / Tên) ==
U -> FE : Nhập Họ, Tên đệm, Tên, SĐT
activate FE
FE -> JWT : PUT /api/auth/profile\n{ho, ten_dem, ten, phone}\nAuthorization: Bearer <token>
activate JWT
JWT -> JWT : jwt.verify(token, SECRET)
JWT -> DB : SELECT * FROM nguoi_dung WHERE id = ?
activate DB
DB --> JWT : User
deactivate DB
JWT --> AUTH : req.user = {id, role}
activate AUTH
AUTH -> AUTH : Tính fullName = ho + ten_dem + ten
AUTH -> DB : UPDATE nguoi_dung SET\nho_ten=?, ho=?, ten_dem=?, ten=?,\nso_dien_thoai=? WHERE id = ?
activate DB
DB --> AUTH : OK
deactivate DB
AUTH --> FE : 200 { user: {ho, ten_dem, ten, name, ...} }
deactivate AUTH
deactivate JWT
FE -> FE : AuthContext.updateUser(user)
FE --> U : "Cập nhật hồ sơ thành công!"
deactivate FE

== KIỂM TRA TOKEN (Protected Route) ==
U -> FE : Truy cập /profile hoặc /cart
activate FE
FE -> FE : Đọc token từ localStorage
FE -> JWT : GET /api/auth/me\nAuthorization: Bearer <token>
activate JWT
JWT -> JWT : jwt.verify(token, SECRET)

alt Token hợp lệ
  JWT -> DB : SELECT * FROM nguoi_dung WHERE id = ?
  activate DB
  DB --> JWT : User data (ho, ten_dem, ten, ...)
  deactivate DB
  JWT --> FE : 200 { user }
  FE --> U : Hiển thị trang
else Token hết hạn / không hợp lệ
  JWT --> FE : 401 { message: "Token expired" }
  FE -> FE : localStorage.removeItem('token')
  FE --> U : Redirect → /login
end
deactivate JWT
deactivate FE

@enduml
