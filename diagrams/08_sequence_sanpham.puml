@startuml 08_sequence_sanpham_timkiem
!theme cerulean-outline
title Sơ đồ Tuần tự - Tìm kiếm, Lọc & Xem Sản phẩm\nFlash Sale & Đánh giá

skinparam sequenceArrowThickness 2
skinparam roundcorner 10

actor "Người dùng" as U #LightGreen
participant "React\nFrontend" as FE #LightBlue
participant "Product\nController" as PC #LightYellow
participant "MySQL DB" as DB #LightCoral

== XEM TRANG CHỦ (Flash Sale & Nổi bật) ==
U -> FE : Truy cập /
activate FE
FE -> PC : GET /api/products?noi_bat=1&limit=8
activate PC
PC -> DB : SELECT * FROM san_pham\nWHERE noi_bat=1 AND trang_thai=1\nORDER BY ngay_tao DESC LIMIT 8
activate DB
DB --> PC : Featured products
deactivate DB
PC -> DB : SELECT fs.*, ctfs.gia_flash, ctfs.so_luong_gioi_han,\nctfs.da_ban, sp.ten_san_pham, sp.anh_dai_dien\nFROM flash_sale fs\nJOIN chi_tiet_flash_sale ctfs ON ...\nJOIN san_pham sp ON ...\nWHERE fs.trang_thai=1\nAND NOW() BETWEEN fs.ngay_bat_dau AND fs.ngay_ket_thuc
DB --> PC : Flash sale products
PC --> FE : 200 { featured, flash_sales }
FE --> U : Trang chủ với Flash Sale countdown\nvà sản phẩm nổi bật
deactivate PC
deactivate FE

== XEM DANH SÁCH SẢN PHẨM ==
U -> FE : Truy cập /shop
activate FE
FE -> PC : GET /api/products\n?page=1&limit=12&sort=newest
activate PC
PC -> DB : SELECT sp.*, dm.ten_danh_muc as category_name,\nth.ten_thuong_hieu as brand_name\nFROM san_pham sp\nJOIN danh_muc dm ON dm.ma_danh_muc=sp.ma_danh_muc\nJOIN thuong_hieu th ON th.ma_thuong_hieu=sp.ma_thuong_hieu\nWHERE sp.trang_thai=1\nORDER BY sp.ngay_tao DESC\nLIMIT 12 OFFSET 0
activate DB
DB --> PC : Products array
deactivate DB
PC -> DB : SELECT COUNT(*) FROM san_pham WHERE trang_thai=1
DB --> PC : total_count
PC --> FE : 200 { data: [], pagination:\n{ total, page, limit, totalPages } }
FE --> U : Grid sản phẩm + phân trang
deactivate PC
deactivate FE

== TÌM KIẾM LIVE (Header Search Bar) ==
U -> FE : Gõ từ khóa vào thanh tìm kiếm
activate FE
FE -> FE : Debounce 280ms
FE -> PC : GET /api/products\n?search=laptop gaming&limit=4
activate PC
PC -> DB : SELECT sp.ma_san_pham, sp.ten_san_pham,\nsp.duong_dan, sp.anh_dai_dien,\nsp.gia_goc, sp.gia_khuyen_mai\nFROM san_pham sp\nWHERE sp.ten_san_pham LIKE '%laptop gaming%'\nAND sp.trang_thai=1 LIMIT 4
activate DB
DB --> PC : Quick search results
deactivate DB
PC --> FE : 200 { data: [4 products] }
FE --> U : Dropdown kết quả tìm kiếm
deactivate PC
deactivate FE

== LỌC SẢN PHẨM ==
U -> FE : Chọn bộ lọc\n(danh mục, thương hiệu, giá, đánh giá, sort)
activate FE
FE -> PC : GET /api/products\n?category=2\n&brand=1,3\n&min_price=15000000\n&max_price=40000000\n&sort=price_asc\n&page=1
activate PC
PC -> PC : Build dynamic WHERE clause
PC -> DB : SELECT sp.*, dm.ten_danh_muc, th.ten_thuong_hieu\nFROM san_pham sp\nJOIN danh_muc dm ON ...\nJOIN thuong_hieu th ON ...\nWHERE sp.trang_thai=1\nAND sp.ma_danh_muc=2\nAND sp.ma_thuong_hieu IN (1,3)\nAND sp.gia_goc BETWEEN 15000000 AND 40000000\nORDER BY sp.gia_goc ASC\nLIMIT 12 OFFSET 0
activate DB
DB --> PC : Filtered products
deactivate DB
PC --> FE : 200 { data, pagination, filters_applied }
FE --> U : Cập nhật kết quả lọc\n(URL cũng cập nhật để share)
deactivate PC
deactivate FE

== XEM CHI TIẾT SẢN PHẨM ==
U -> FE : Click vào sản phẩm
activate FE
FE -> PC : GET /api/products/:slug
activate PC

PC -> DB : SELECT sp.*, dm.ten_danh_muc, th.ten_thuong_hieu\nFROM san_pham sp\nJOIN danh_muc dm ON ...\nJOIN thuong_hieu th ON ...\nWHERE sp.duong_dan=? AND sp.trang_thai=1
activate DB
DB --> PC : Product record
deactivate DB

PC -> DB : SELECT * FROM thong_so_ky_thuat\nWHERE ma_san_pham=?\nORDER BY thu_tu
DB --> PC : Thông số kỹ thuật (10 specs)

PC -> DB : SELECT * FROM anh_san_pham\nWHERE ma_san_pham=?\nORDER BY thu_tu
DB --> PC : Images array

PC -> DB : SELECT dg.*, nd.ho_ten, nd.anh_dai_dien\nFROM danh_gia dg\nJOIN nguoi_dung nd ON nd.ma_nguoi_dung=dg.ma_nguoi_dung\nWHERE dg.ma_san_pham=?\nAND dg.trang_thai='da_duyet'\nORDER BY dg.ngay_tao DESC LIMIT 5
DB --> PC : Reviews (đã duyệt)

PC -> DB : SELECT * FROM san_pham\nWHERE ma_danh_muc=? AND ma_san_pham!=?\nAND trang_thai=1\nORDER BY luot_xem DESC LIMIT 8
DB --> PC : Related products

PC -> DB : UPDATE san_pham SET\nluot_xem = luot_xem + 1 WHERE ma_san_pham=?

PC --> FE : 200 {\n  san_pham, thong_so, anh,\n  danh_gia, san_pham_lien_quan\n}
FE --> U : Trang chi tiết SP:\n- Gallery ảnh\n- Thông số kỹ thuật\n- Đánh giá sao\n- SP liên quan\n- Nút So sánh / Yêu thích
deactivate PC
deactivate FE

== SO SÁNH SẢN PHẨM ==
U -> FE : Thêm SP vào CompareBar (tối đa 4)
activate FE
FE -> FE : Lưu IDs trong localStorage
FE -> PC : GET /api/products/compare?ids=5,12,18
activate PC
PC -> DB : SELECT sp.*, tskt.ten_thong_so, tskt.gia_tri\nFROM san_pham sp\nJOIN thong_so_ky_thuat tskt ON ...\nWHERE sp.ma_san_pham IN (5,12,18)\nORDER BY sp.ma_san_pham, tskt.thu_tu
activate DB
DB --> PC : Products with specs
deactivate DB
PC -> PC : Group specs theo ten_thong_so
PC --> FE : 200 { products: [{ san_pham, specs_map }] }
FE --> U : Bảng so sánh thông số kỹ thuật
deactivate PC
deactivate FE

== THÊM ĐÁNH GIÁ (Sau khi mua hàng) ==
U -> FE : Vào lịch sử đơn hàng → Click "Đánh giá"
activate FE
FE -> PC : POST /api/reviews\n{ma_san_pham, ma_chi_tiet_dh,\n so_sao, binh_luan}\n[JWT Bearer]
activate PC
PC -> DB : SELECT ctdh.*, dh.ma_nguoi_dung, dh.trang_thai\nFROM chi_tiet_don_hang ctdh\nJOIN don_hang dh ON dh.ma_don_hang=ctdh.ma_don_hang\nWHERE ctdh.ma_chi_tiet=? AND dh.ma_nguoi_dung=?\nAND dh.trang_thai='da_giao'
activate DB
DB --> PC : Verify purchase
deactivate DB
alt Đã mua & đã nhận hàng
  PC -> DB : INSERT INTO danh_gia\n(ma_nguoi_dung, ma_san_pham, ma_chi_tiet_dh,\n so_sao, binh_luan, trang_thai='cho_duyet')
  DB --> PC : ma_danh_gia
  PC -> DB : UPDATE san_pham SET\ndanh_gia_tb = (SELECT AVG(so_sao)\nFROM danh_gia WHERE ma_san_pham=?\nAND trang_thai='da_duyet')
  PC --> FE : 201 { message: "Đánh giá đang chờ duyệt" }
  FE --> U : ✅ "Cảm ơn đánh giá của bạn!"
else Chưa mua hoặc đơn chưa giao
  PC --> FE : 403 { message: "Chỉ khách đã nhận hàng mới đánh giá được" }
  FE --> U : ❌ Thông báo lỗi
end
deactivate PC
deactivate FE

@enduml
