@startuml 03_class_diagram
!theme cerulean-outline
title Sơ đồ Lớp (Class Diagram)\nHệ thống Quản lý Cửa hàng Thiết bị Công nghệ

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #EBF5FB
  BorderColor #2471A3
  HeaderBackgroundColor #2471A3
  HeaderFontColor white
  FontSize 12
}
skinparam arrow {
  Color #1A5276
}

'============ NGƯỜI DÙNG & XÁC THỰC ============
class User {
  +int id
  +String name
  +String email
  +String password_hash
  +Enum role <<admin|staff|user>>
  +String phone
  +Text address
  +int loyalty_points
  +Boolean is_active
  +DateTime email_verified_at
  +DateTime created_at
  +DateTime updated_at
  --
  +register() : User
  +login() : Token
  +logout() : void
  +updateProfile() : User
  +changePassword() : Boolean
  +getOrders() : Order[]
  +getWishlist() : Product[]
  +addLoyaltyPoints(points: int) : void
  +useLoyaltyPoints(points: int) : Boolean
}

'============ SẢN PHẨM ============
class Category {
  +int id
  +String name
  +String slug
  +Text description
  +String image_url
  +int parent_id
  +Boolean is_active
  +int sort_order
  +DateTime created_at
  --
  +create() : Category
  +update() : Category
  +delete() : Boolean
  +getChildren() : Category[]
  +getProducts() : Product[]
}

class Brand {
  +int id
  +String name
  +String slug
  +String logo_url
  +String country
  +Boolean is_active
  --
  +create() : Brand
  +update() : Brand
  +getProducts() : Product[]
}

class Product {
  +int id
  +String name
  +String slug
  +Text description
  +Text short_desc
  +Decimal price
  +Decimal sale_price
  +int stock_quantity
  +int min_stock_alert
  +int category_id
  +int brand_id
  +String thumbnail
  +Boolean is_active
  +Boolean is_featured
  +int view_count
  +float avg_rating
  +DateTime created_at
  +DateTime updated_at
  --
  +create() : Product
  +update() : Product
  +delete() : Boolean
  +search(keyword: String) : Product[]
  +filter(params: Object) : Product[]
  +updateStock(qty: int, type: String) : void
  +getSpecs() : ProductSpec[]
  +getImages() : ProductImage[]
  +getReviews() : Review[]
  +checkLowStock() : Boolean
}

class ProductSpec {
  +int id
  +int product_id
  +String spec_name
  +String spec_value
  +String unit
  +int sort_order
  --
  +create() : void
  +bulkCreate(specs: Array) : void
}

class ProductImage {
  +int id
  +int product_id
  +String image_url
  +Boolean is_primary
  +int sort_order
  --
  +upload() : String
  +setPrimary() : void
}

class Wishlist {
  +int id
  +int user_id
  +int product_id
  +DateTime created_at
  --
  +add() : Wishlist
  +remove() : Boolean
}

class CompareList {
  +int id
  +int user_id
  +int product_id
  +DateTime created_at
  --
  +add() : void
  +remove() : void
  +getProducts() : Product[]
}

'============ GIỎ HÀNG & ĐẶT HÀNG ============
class Cart {
  +int id
  +int user_id
  +DateTime created_at
  +DateTime updated_at
  --
  +addItem(productId: int, qty: int) : CartItem
  +removeItem(itemId: int) : Boolean
  +updateQuantity(itemId: int, qty: int) : void
  +clear() : void
  +getTotal() : Decimal
  +getItemCount() : int
  +applyVoucher(code: String) : DiscountResult
}

class CartItem {
  +int id
  +int cart_id
  +int product_id
  +int quantity
  +Decimal unit_price
  --
  +getSubtotal() : Decimal
}

class Order {
  +int id
  +int user_id
  +String order_code
  +Decimal subtotal
  +Decimal discount_amount
  +Decimal shipping_fee
  +Decimal total_amount
  +int voucher_id
  +int loyalty_points_used
  +int loyalty_points_earned
  +Enum status <<pending|confirmed|shipping|delivered|cancelled|refunded>>
  +Enum payment_method <<cod|bank_transfer|momo|points>>
  +Enum payment_status <<unpaid|paid|refunded>>
  +Text shipping_address
  +String receiver_name
  +String receiver_phone
  +Text note
  +DateTime created_at
  +DateTime updated_at
  --
  +create() : Order
  +updateStatus(status: String) : void
  +cancel() : Boolean
  +calculateTotal() : Decimal
  +getItems() : OrderItem[]
  +generateCode() : String
}

class OrderItem {
  +int id
  +int order_id
  +int product_id
  +String product_name
  +Decimal unit_price
  +int quantity
  +Decimal subtotal
  --
  +getSubtotal() : Decimal
}

'============ VOUCHER & KHUYẾN MÃI ============
class Voucher {
  +int id
  +String code
  +String name
  +Text description
  +Enum discount_type <<percent|fixed_amount>>
  +Decimal discount_value
  +Decimal max_discount_amount
  +Decimal min_order_value
  +int max_uses
  +int used_count
  +int max_uses_per_user
  +Boolean is_active
  +DateTime start_date
  +DateTime expired_at
  +DateTime created_at
  --
  +validate(userId: int, orderValue: Decimal) : Boolean
  +apply(orderValue: Decimal) : Decimal
  +incrementUsedCount() : void
  +checkExpired() : Boolean
  +generateCode() : String
}

class VoucherUsage {
  +int id
  +int voucher_id
  +int user_id
  +int order_id
  +Decimal discount_applied
  +DateTime used_at
  --
  +record() : void
}

'============ BẢO HÀNH ============
class WarrantyRequest {
  +int id
  +int user_id
  +int order_item_id
  +String serial_number
  +Text issue_description
  +Enum status <<pending|processing|completed|rejected>>
  +String assigned_staff_id
  +Text resolution_note
  +DateTime received_at
  +DateTime completed_at
  --
  +create() : WarrantyRequest
  +updateStatus() : void
  +assignStaff(staffId: int) : void
}

'============ ĐÁNH GIÁ ============
class Review {
  +int id
  +int user_id
  +int product_id
  +int order_item_id
  +int rating
  +Text comment
  +Boolean is_approved
  +DateTime created_at
  --
  +create() : Review
  +approve() : void
  +delete() : Boolean
}

'============ KHO HÀNG ============
class InventoryLog {
  +int id
  +int product_id
  +int user_id
  +int quantity_change
  +int stock_before
  +int stock_after
  +Enum type <<import|export|adjustment|return>>
  +Text note
  +String reference_code
  +DateTime created_at
  --
  +logImport(qty: int) : void
  +logExport(qty: int) : void
  +logAdjustment(qty: int) : void
}

'============ THÔNG BÁO ============
class Notification {
  +int id
  +int user_id
  +String title
  +Text content
  +String type
  +Boolean is_read
  +String ref_id
  +DateTime created_at
  --
  +send() : void
  +markRead() : void
}

'============ RELATIONSHIPS ============
User "1" --o{ Order : "đặt"
User "1" --|| Cart : "có"
User "1" --o{ Review : "viết"
User "1" --o{ Wishlist : "lưu"
User "1" --o{ CompareList : "so sánh"
User "1" --o{ WarrantyRequest : "yêu cầu"
User "1" --o{ Notification : "nhận"
User "1" --o{ VoucherUsage : "sử dụng"

Order "1" *--{ OrderItem : "chứa"
Order "1" --o| Voucher : "áp dụng"
Order "1" --o{ VoucherUsage : "ghi nhận"

Cart "1" *--o{ CartItem : "chứa"

Product "1" --o{ OrderItem : "thuộc"
Product "1" --o{ CartItem : "thuộc"
Product "1" *--{ ProductSpec : "có"
Product "1" *--{ ProductImage : "có"
Product "1" --o{ Review : "nhận"
Product "1" --o{ InventoryLog : "theo dõi"
Product "1" --o{ Wishlist : "được lưu"
Product "1" --o{ CompareList : "được ss"

Product "}o" -- "1|" Category : "thuộc"
Product "}o" -- "1|" Brand : "của"
Category "1" --o{ Category : "parent/child"

Voucher "1" --o{ VoucherUsage : "được dùng"
OrderItem "1" --o| WarrantyRequest : "bảo hành"

@enduml
