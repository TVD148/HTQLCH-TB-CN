@startuml 03_class_diagram
!theme cerulean-outline
title Sơ đồ Lớp (Class Diagram)\nHệ thống Quản lý Cửa hàng Thiết bị Công nghệ\nPhiên bản: 2.0 — Đồng bộ với code thực tế

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #EBF5FB
  BorderColor #2471A3
  HeaderBackgroundColor #2471A3
  HeaderFontColor white
  FontSize 12
}
skinparam arrow {
  Color #1A5276
}

'============ NGƯỜI DÙNG & XÁC THỰC ============
class NguoiDung {
  +int ma_nguoi_dung
  +String ho_ten
  +String ho
  +String ten_dem
  +String ten
  +String email
  +String mat_khau_ma_hoa
  +Enum vai_tro <<admin|staff|khach_hang>>
  +String so_dien_thoai
  +Text dia_chi
  +String anh_dai_dien
  +int diem_tich_luy
  +Boolean trang_thai
  +Timestamp ngay_xac_thuc_email
  +Timestamp ngay_tao
  +Timestamp ngay_cap_nhat
  --
  +dangKy() : NguoiDung
  +dangNhap() : Token
  +dangXuat() : void
  +capNhatHoSo() : NguoiDung
  +doiMatKhau() : Boolean
  +layDonHang() : DonHang[]
  +layYeuThich() : SanPham[]
  +themDiemTichLuy(diem: int) : void
  +dungDiemTichLuy(diem: int) : Boolean
}

'============ ĐỊA CHỈ ============
class DiaChiNguoiDung {
  +int ma_dia_chi
  +int ma_nguoi_dung
  +String ten_nhan
  +Text dia_chi_day_du
  +String tinh_thanh
  +String quan_huyen
  +Decimal lat
  +Decimal lng
  +Boolean la_mac_dinh
  +Timestamp ngay_tao
  --
  +them() : DiaChiNguoiDung
  +sua() : DiaChiNguoiDung
  +xoa() : Boolean
  +datMacDinh() : void
}

'============ DANH MỤC & THƯƠNG HIỆU ============
class DanhMuc {
  +int ma_danh_muc
  +String ten_danh_muc
  +String duong_dan
  +Text mo_ta
  +String hinh_anh
  +int ma_danh_muc_cha
  +Boolean trang_thai
  +int thu_tu
  +Timestamp ngay_tao
  --
  +them() : DanhMuc
  +sua() : DanhMuc
  +xoa() : Boolean
  +layDanhMucCon() : DanhMuc[]
  +laySanPham() : SanPham[]
}

class ThuongHieu {
  +int ma_thuong_hieu
  +String ten_thuong_hieu
  +String duong_dan
  +String logo
  +String quoc_gia
  +Boolean trang_thai
  +Timestamp ngay_tao
  --
  +them() : ThuongHieu
  +sua() : ThuongHieu
  +xoa() : Boolean
  +laySanPham() : SanPham[]
}

'============ SẢN PHẨM ============
class SanPham {
  +int ma_san_pham
  +String ten_san_pham
  +String duong_dan
  +Text mo_ta
  +Text mo_ta_ngan
  +Decimal gia_goc
  +Decimal gia_khuyen_mai
  +int so_luong_ton
  +int canh_bao_ton_toi_thieu
  +int ma_danh_muc
  +int ma_thuong_hieu
  +String anh_dai_dien
  +Boolean trang_thai
  +Boolean noi_bat
  +int luot_xem
  +Decimal danh_gia_tb
  +int thoi_gian_bao_hanh
  +Decimal phi_van_chuyen
  +Timestamp ngay_tao
  +Timestamp ngay_cap_nhat
  --
  +them() : SanPham
  +sua() : SanPham
  +an() : Boolean
  +timKiem(tuKhoa: String) : SanPham[]
  +loc(params: Object) : SanPham[]
  +capNhatTonKho(sl: int, loai: String) : void
  +layThongSo() : ThongSoKyThuat[]
  +layAnh() : AnhSanPham[]
  +layDanhGia() : DanhGia[]
  +laySanPhamLienQuan() : SanPham[]
}

class ThongSoKyThuat {
  +int ma_thong_so
  +int ma_san_pham
  +String ten_thong_so
  +String gia_tri
  +String don_vi
  +int thu_tu
  --
  +themHangLoat(specs: Array) : void
  +xoaTheoSanPham(maSP: int) : void
}

class AnhSanPham {
  +int ma_anh
  +int ma_san_pham
  +String duong_dan_anh
  +Boolean la_anh_chinh
  +int thu_tu
  --
  +taiLen() : String
  +datAnhChinh() : void
}

class YeuThich {
  +int ma_yeu_thich
  +int ma_nguoi_dung
  +int ma_san_pham
  +Timestamp ngay_them
  --
  +them() : YeuThich
  +xoa() : Boolean
  +kiemTraTonTai(userId, spId) : Boolean
}

'============ GIỎ HÀNG ============
class GioHang {
  +int ma_gio_hang
  +int ma_nguoi_dung
  +Timestamp ngay_tao
  +Timestamp ngay_cap_nhat
  --
  +themSanPham(maSP: int, sl: int) : ChiTietGioHang
  +xoaSanPham(maChiTiet: int) : Boolean
  +capNhatSoLuong(maChiTiet: int, sl: int) : void
  +lamTrong() : void
  +tinhTongTien() : Decimal
  +laySoLuong() : int
}

class ChiTietGioHang {
  +int ma_chi_tiet
  +int ma_gio_hang
  +int ma_san_pham
  +int so_luong
  +Decimal don_gia
  +Timestamp ngay_them
  --
  +tinhThanhTien() : Decimal
}

'============ ĐƠN HÀNG ============
class DonHang {
  +int ma_don_hang
  +int ma_nguoi_dung
  +String ma_code
  +Decimal tam_tinh
  +Decimal so_tien_giam
  +Decimal phi_van_chuyen
  +Decimal so_tien_giam_ship
  +Decimal tong_tien
  +int ma_voucher
  +int ma_voucher_ship
  +int diem_su_dung
  +int diem_tich_duoc
  +Enum trang_thai <<cho_xac_nhan|da_xac_nhan|dang_giao|da_giao|da_huy|hoan_tien>>
  +Enum phuong_thuc_tt <<tien_mat|chuyen_khoan|momo|diem_tich_luy>>
  +Enum trang_thai_tt <<chua_tt|da_tt|da_hoan_tien>>
  +String ten_nguoi_nhan
  +String sdt_nguoi_nhan
  +Text dia_chi_giao_hang
  +Text ghi_chu
  +Timestamp ngay_tao
  +Timestamp ngay_cap_nhat
  --
  +tao() : DonHang
  +capNhatTrangThai(tt: String) : void
  +huy() : Boolean
  +tinhTong() : Decimal
  +layChiTiet() : ChiTietDonHang[]
  +taoMaCode() : String
  +guiThongBao(tt: String) : void
}

class ChiTietDonHang {
  +int ma_chi_tiet
  +int ma_don_hang
  +int ma_san_pham
  +String ten_san_pham
  +String anh_san_pham
  +Decimal don_gia
  +int so_luong
  +Decimal thanh_tien
  --
  +tinhThanhTien() : Decimal
}

'============ VOUCHER ============
class MaGiamGia {
  +int ma_voucher
  +String ma_code
