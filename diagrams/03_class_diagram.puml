  +Decimal don_hang_toi_thieu
  +int so_lan_toi_da
  +int da_su_dung
  +int gioi_han_moi_nguoi
  +Enum loai_voucher <<product|shipping|promo_code>>
  +Boolean trang_thai
  +DateTime ngay_bat_dau
  +DateTime ngay_het_han
  +DateTime ngay_tao
  --
  +kiemTraHopLe(userId: int, giaTriDon: Decimal) : Boolean
  +apDung(giaTriDon: Decimal) : Decimal
  +tangDaSuDung() : void
  +kiemTraHetHan() : Boolean
}

class VoucherNguoiDung {
  +int ma_id
  +int ma_voucher
  +int ma_nguoi_dung
  +Boolean da_su_dung
  +Timestamp ngay_gui
  +Timestamp ngay_su_dung
  --
  +capPhat(userId: int) : void
  +danhDauDaDung() : void
}

class LichSuVoucher {
  +int ma_lich_su
  +int ma_voucher
  +int ma_nguoi_dung
  +int ma_don_hang
  +Decimal so_tien_giam
  +Timestamp ngay_su_dung
  --
  +ghiNhan() : void
}

'============ BẢO HÀNH ============
