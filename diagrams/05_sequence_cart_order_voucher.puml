@startuml 05_sequence_muahang_voucher
!theme cerulean-outline
title Sơ đồ Tuần tự - Giỏ hàng, Voucher & Đặt hàng

skinparam sequenceArrowThickness 2
skinparam roundcorner 10

actor "Khách hàng" as KH #LightGreen
participant "React\nFrontend" as FE #LightBlue
participant "Cart\nRoute" as CART #LightYellow
participant "Order\nController" as ORDER #LightYellow
participant "MySQL DB" as DB #LightCoral

== THÊM VÀO GIỎ HÀNG ==
KH -> FE : Click "Thêm vào giỏ"
activate FE
FE -> CART : POST /api/cart/add\n{product_id, quantity}\n[JWT Bearer]
activate CART
CART -> DB : SELECT so_luong_ton FROM san_pham WHERE id=?
activate DB
DB --> CART : so_luong_ton
deactivate DB

alt Đủ hàng trong kho
  CART -> DB : INSERT/UPDATE chi_tiet_gio_hang\n(ma_gio_hang, ma_san_pham, so_luong, don_gia)
  DB --> CART : Updated
  CART -> DB : SELECT COUNT(*) FROM chi_tiet_gio_hang WHERE ma_gio_hang=?
  DB --> CART : cart_count
  CART --> FE : 200 { cart_count, item_count }
  FE --> KH : 🛒 Badge cập nhật số lượng
else Hết hàng
  CART --> FE : 400 { message: "Sản phẩm đã hết hàng" }
  FE --> KH : Toast "Sản phẩm đã hết hàng"
end
deactivate CART
deactivate FE

== ÁP DỤNG MÃ VOUCHER GIẢM GIÁ SẢN PHẨM ==
KH -> FE : Nhập mã voucher SP và click "Áp dụng"
activate FE
FE -> CART : POST /api/vouchers/validate\n{code, cart_total}\n[JWT Bearer]
activate CART
CART -> DB : SELECT * FROM ma_giam_gia\nWHERE ma_code=? AND trang_thai=1\nAND het_han >= NOW()
activate DB
DB --> CART : Voucher record
deactivate DB

alt Voucher không tồn tại / hết hạn
  CART --> FE : 400 { message: "Mã không hợp lệ hoặc đã hết hạn" }
  FE --> KH : ❌ Hiển thị lỗi

else Đơn hàng chưa đủ điều kiện
  CART --> FE : 400 { min_order: X }
  FE --> KH : ❌ "Đơn tối thiểu [X]đ mới áp dụng"

else Đã dùng hết lượt
  CART --> FE : 400 { message: "Bạn đã sử dụng mã này" }
  FE --> KH : ❌ "Voucher đã được sử dụng"

else Hợp lệ
  CART -> DB : SELECT * FROM voucher_nguoi_dung\nWHERE ma_voucher=? AND ma_nguoi_dung=?\nAND da_su_dung=0
  DB --> CART : voucher_user_record
  CART --> FE : 200 { discount_amount, final_total, voucher }
  FE --> KH : ✅ "Giảm [X]đ! Tổng còn [Y]đ"
end
deactivate CART
deactivate FE

== ÁP DỤNG VOUCHER GIẢM PHÍ VẬN CHUYỂN ==
KH -> FE : Nhập mã voucher ship
activate FE
FE -> CART : POST /api/vouchers/validate\n{code, shipping_fee, type:'shipping'}
activate CART
CART -> DB : SELECT * FROM ma_giam_gia\nWHERE ma_code=? AND loai_giam='freeship'
DB --> CART : Voucher ship record
CART --> FE : 200 { shipping_discount }
deactivate CART
FE --> KH : ✅ "Miễn/giảm phí vận chuyển [X]đ"
deactivate FE

== ĐẶT HÀNG ==
KH -> FE : Xác nhận đặt hàng
activate FE
FE -> ORDER : POST /api/orders\n{dia_chi_giao_hang (từ DCND),\n phuong_thuc_tt,\n product_voucher_id,\n shipping_voucher_id,\n loyalty_points_used}\n[JWT Bearer]
activate ORDER

ORDER -> DB : BEGIN TRANSACTION

ORDER -> DB : SELECT * FROM chi_tiet_gio_hang\nJOIN san_pham USING(ma_san_pham)\nWHERE ma_gio_hang = ?
DB --> ORDER : Items với phi_van_chuyen/sản phẩm

loop Mỗi sản phẩm trong giỏ
  alt so_luong > so_luong_ton
    ORDER -> DB : ROLLBACK
    ORDER --> FE : 400 { message: "Hết hàng: [tên SP]" }
    FE --> KH : ❌ Thông báo hết hàng
  end
end

ORDER -> ORDER : tinhTongTien()\ntam_tinh + phi_van_chuyen\n- giam_SP - giam_ship - diem
ORDER -> ORDER : taoMaCode()\n→ DH-DDMMYYYY-NNN

ORDER -> DB : INSERT INTO don_hang\n(ma_nguoi_dung, ma_code, tam_tinh,\nso_tien_giam, phi_van_chuyen,\nso_tien_giam_ship, tong_tien,\nma_voucher, ma_voucher_ship,\ndiem_su_dung, diem_tich_duoc,\ntrang_thai='cho_xac_nhan', ...)
DB --> ORDER : ma_don_hang

ORDER -> DB : INSERT INTO chi_tiet_don_hang (bulk)

ORDER -> DB : UPDATE san_pham SET so_luong_ton -= qty\n(foreach item)

ORDER -> DB : INSERT INTO lich_su_kho\n(loai_giao_dich='xuat', foreach item)

alt Có voucher sản phẩm
  ORDER -> DB : UPDATE ma_giam_gia SET da_su_dung += 1
  ORDER -> DB : UPDATE voucher_nguoi_dung SET da_su_dung=1
  ORDER -> DB : INSERT INTO lich_su_voucher
end

alt Có voucher ship
  ORDER -> DB : UPDATE voucher ship tương tự
end

alt Sử dụng điểm tích lũy
  ORDER -> DB : UPDATE nguoi_dung SET\ndiem_tich_luy -= diem_su_dung
end

ORDER -> DB : DELETE FROM chi_tiet_gio_hang WHERE ma_gio_hang=?

alt diem_tich_duoc > 0
  ORDER -> DB : UPDATE nguoi_dung SET\ndiem_tich_luy += diem_tich_duoc
end

ORDER -> DB : COMMIT
ORDER -> DB : INSERT INTO thong_bao\n(userId, "Đặt hàng thành công! 🎉", ...)
ORDER --> FE : 201 {\n  order_id, order_code, total_amount,\n  loyalty_points_earned\n}
FE --> KH : 🎉 "Đặt hàng thành công!\nMã đơn: #DH-..."

deactivate ORDER
deactivate FE

@enduml
