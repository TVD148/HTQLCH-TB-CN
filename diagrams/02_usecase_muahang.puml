@startuml UC02_MuaHang_Voucher
!theme cerulean-outline
title Sơ đồ Use Case Chi tiết\nQuy trình Mua hàng & Áp dụng Voucher

skinparam ActorStyle awesome
skinparam usecase {
  BackgroundColor #E8F4FD
  BorderColor #2980B9
}

actor "Khách hàng" as KH #LightGreen
actor "Hệ thống" as SYS #LightBlue

rectangle "Quy trình Mua hàng" {

  usecase "Xem chi tiết\nsản phẩm" as UC1
  usecase "Thêm vào\ngiỏ hàng" as UC2
  usecase "Xem giỏ hàng\n& Tóm tắt" as UC3
  usecase "Cập nhật số\nlượng SP" as UC4
  usecase "Xóa SP\nkhỏi giỏ" as UC5
  usecase "Áp dụng Voucher\ngiảm giá SP" as UC6
  usecase "Áp dụng Voucher\ngiảm phí ship" as UC6B
  usecase "Kiểm tra\nhợp lệ Voucher" as UC7
  usecase "Sử dụng\nđiểm tích lũy" as UC_POINTS
  usecase "Chọn địa chỉ\ngiao hàng đã lưu" as UC9
  usecase "Chọn phương thức\nthanh toán" as UC10
  usecase "Xác nhận\nđặt hàng" as UC11
  usecase "Thanh toán\nTiền mặt (COD)" as UC12
  usecase "Thanh toán\nChuyển khoản" as UC13
  usecase "Thanh toán\nMoMo (giả lập)" as UC14
  usecase "Tạo đơn hàng\ntrong hệ thống" as UC15
  usecase "Cập nhật\ntồn kho" as UC17
  usecase "Tặng điểm\ntích lũy" as UC18
  usecase "Gửi thông báo\nđặt hàng" as UC19
  usecase "Hủy đơn hàng\n(trước khi ship)" as UC20
  usecase "Xem lịch sử\nđơn hàng" as UC21
  usecase "Mua lại\nđơn cũ" as UC22

  UC3 .> UC4 : <<extend>>
  UC3 .> UC5 : <<extend>>
  UC3 .> UC6 : <<extend>>
  UC3 .> UC6B : <<extend>>
  UC3 .> UC_POINTS : <<extend>>
  UC6 .> UC7 : <<include>>
  UC6B .> UC7 : <<include>>
  UC11 .> UC9 : <<include>>
  UC11 .> UC10 : <<include>>
  UC10 .> UC12 : <<extend>>
  UC10 .> UC13 : <<extend>>
  UC10 .> UC14 : <<extend>>
  UC11 .> UC15 : <<include>>
  UC15 .> UC17 : <<include>>
  UC15 .> UC18 : <<include>>
  UC15 .> UC19 : <<include>>
  UC22 .> UC2 : <<include>>
}

KH --> UC1
KH --> UC2
KH --> UC3
KH --> UC11
KH --> UC20
KH --> UC21
KH --> UC22
UC14 --> SYS
UC19 --> SYS

note top of UC7
  Kiểm tra:
  - Mã tồn tại trong DB
  - Chưa hết hạn (het_han)
  - Số lần dùng < gioi_han_su_dung
  - Giá trị đơn >= don_hang_toi_thieu
  - Chưa được KH này dùng
  - Đúng loại voucher (SP / ship)
end note

note bottom of UC_POINTS
  1 điểm = 1.000đ
  Tích lũy: 1 điểm / 100.000đ đơn hàng
  Có thể kết hợp với voucher
end note

note right of UC9
  Chọn từ danh sách
  địa chỉ đã lưu
  hoặc nhập địa chỉ mới
  (OpenStreetMap picker)
end note

@enduml
