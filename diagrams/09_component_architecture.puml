@startuml 09_component_diagram
!theme cerulean-outline
title Sơ đồ Thành phần (Component Diagram)\nKiến trúc Hệ thống Quản lý Cửa hàng TBCN

skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #EBF5FB
  BorderColor #2471A3
}

package "🌐 Client Layer" {
  [Browser / Mobile Web] as CLIENT
}

package "⚛️ Frontend - ReactJS (Vite + React Router v6)" {
  package "Pages (User)" {
    [HomePage\n(Flash Sale, Featured)] as HP
    [ShopPage\n(Filter, Sort, Search)] as SHP
    [ProductDetailPage\n(Specs, Reviews, Compare)] as PDP
    [CartPage] as CP
    [CheckoutPage\n(Voucher x2, Loyalty Points)] as CKP
    [ProfilePage\n(Orders, Address, Voucher, Review)] as PRF
    [OrderDetailPage] as ODP
    [WarrantyPage] as WR
    [WishlistPage] as WL
    [ComparePage] as CMP
    [LoginPage / RegisterPage] as AUTHP
  }

  package "Pages (Admin / Staff)" {
    [AdminDashboard] as ADASH
    [AdminProducts] as APROD
    [AdminOrders] as AORD
    [AdminUsers] as AUSR
    [AdminVouchers] as AVCH
    [AdminWarranty] as AWAR
    [AdminInventory] as AINV
    [AdminReviews] as AREV
    [AdminReports] as AREP
    [AdminNotifications] as ANOT
    [AdminFlashSale] as AFS
    [AdminCategories] as ACAT
    [AdminBrands] as ABRD
  }

  package "Shared Components" {
    [Header\n(Search Live, Notif Bell, Cart)] as NAV
    [Footer] as FOOT
    [ProductCard] as PCARD
    [CompareBar] as CBAR
  }

  package "Context (State Management)" {
    [AuthContext\n(user, login, logout)] as ACTX
    [CartContext\n(cart, addToCart, count)] as CCTX
    [ThemeContext\n(light/dark)] as TCTX
    [CompareContext\n(compare list, max 4)] as CMCTX
  }

  package "API Layer (axios)" {
    [axiosInstance\n(JWT Interceptor)] as AXI
    [authApi] as AAPI
    [productApi] as PAPI
    [cartApi] as CAPI
    [orderApi] as OAPI
    [voucherApi] as VAPI
    [addressApi] as ADDAPI
    [warrantyApi] as WAPI
    [notificationApi] as NAPI
    [reviewApi] as RAPI
    [wishlistApi] as WIAPI
    [adminApi] as ADAPI
  }
}

package "🟢 Backend - NodeJS + Express" {
  package "Middleware" {
    [CORS\n(localhost:5173)] as CORS
    [Morgan Logger] as LOG
    [verifyToken (JWT)] as VJWT
    [requireAdmin / requireStaff\n(RBAC)] as RBAC
    [errorHandler] as ERH
    [multer\n(Upload ảnh)] as MULTER
  }

  package "Routes" {
    [/api/auth/*] as RAUTH
    [/api/products/*] as RPROD
    [/api/categories/*] as RCAT
    [/api/brands/*] as RBRND
    [/api/cart/*] as RCART
    [/api/orders/*] as RORD
    [/api/reviews/*] as RREV
    [/api/vouchers/*] as RVCH
    [/api/wishlist/*] as RWISH
    [/api/warranty/*] as RWAR
    [/api/addresses/*] as RADR
    [/api/notifications/*] as RNOT
    [/api/admin/*] as RADM
  }

  package "Controllers" {
    [authController\n(register, login, profile)] as CAU
    [productController\n(list, detail, filter)] as CPROD
    [orderController\n(create, cancel, list)] as CORD
    [adminController\n(users, reports, orders)] as CADM
  }
}

package "🗄️ Database - MySQL (XAMPP)" {
  database "htqlch_thietbi_cn (utf8mb4)" {
    [nguoi_dung\n(ho, ten_dem, ten)] as TND
    [san_pham\n+ phi_van_chuyen] as TSP
    [danh_muc / thuong_hieu] as TDM
    [gio_hang / chi_tiet_gio_hang] as TGH
    [don_hang / chi_tiet_don_hang\n(ma_voucher, ma_voucher_ship)] as TDH
    [ma_giam_gia\n(product | shipping | freeship)] as TMG
    [voucher_nguoi_dung\n/ lich_su_voucher] as TVD
    [danh_gia\n(da_duyet, phan_hoi_admin)] as TDG
    [yeu_cau_bao_hanh\n(hinh_thuc, so_dien_thoai, lich_hen)] as TBHH
    [lich_su_kho] as TLSK
    [thong_bao] as TTB
    [yeu_thich] as TYT
    [anh_san_pham\n/ thong_so_ky_thuat] as TASP
    [dia_chi_nguoi_dung\n(lat, lng)] as TDCND
    [flash_sale / chi_tiet_flash_sale] as TFS
  }
}

'============ CONNECTIONS ============
CLIENT --> AXI : HTTPS Requests
AXI --> RAUTH
AXI --> RPROD
AXI --> RCART
AXI --> RORD
AXI --> RVCH
AXI --> RWISH
AXI --> RWAR
AXI --> RNOT
AXI --> RADR
AXI --> RADM

RAUTH --> CAU
RPROD --> CPROD
RCART --> VJWT
RORD --> VJWT
RORD --> CORD
RADM --> VJWT
RADM --> RBAC
RADM --> CADM

CAU --> TND
CPROD --> TSP
CPROD --> TDM
CORD --> TDH
CORD --> TMG
CORD --> TVD
CORD --> TLSK
CORD --> TTB
CADM --> TND
CADM --> TDH
CADM --> TMG
CADM --> TBHH

AXI .> ACTX : "Lưu token"
HP --> NAV
HP --> PCARD
SHP --> PCARD
PDP --> CBAR
CKP --> CCTX
PRF --> ACTX

@enduml
