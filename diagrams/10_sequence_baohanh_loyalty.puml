@startuml 10_sequence_baohanh_loyalty
!theme cerulean-outline
title Sơ đồ Tuần tự - Bảo hành & Chương trình Tích điểm

skinparam sequenceArrowThickness 2
skinparam roundcorner 10

actor "Khách hàng" as KH #LightGreen
actor "Nhân viên" as NV #LightYellow
participant "React FE" as FE #LightBlue
participant "Warranty\nRoute" as WC #Orange
participant "Notifications\nRoute" as NS #Pink
participant "MySQL DB" as DB #LightCoral

== YÊU CẦU BẢO HÀNH ==
KH -> FE : Vào "Đơn hàng của tôi"\n→ Chọn SP "da_giao" → "Yêu cầu bảo hành"
activate FE
FE -> WC : POST /api/warranty\n{ma_chi_tiet_dh, so_serial,\n mo_ta_su_co, hinh_thuc,\n so_dien_thoai, lich_hen}\n[JWT Bearer]
activate WC

WC -> DB : SELECT ctdh.*, dh.ngay_tao, sp.ten_san_pham,\nsp.thoi_gian_bao_hanh\nFROM chi_tiet_don_hang ctdh\nJOIN don_hang dh ON dh.ma_don_hang=ctdh.ma_don_hang\nJOIN san_pham sp ON sp.ma_san_pham=ctdh.ma_san_pham\nWHERE ctdh.id=? AND dh.ma_nguoi_dung=?\nAND dh.trang_thai='da_giao'
activate DB
DB --> WC : Order item + thoi_gian_bao_hanh (tháng)
deactivate DB

WC -> WC : Kiểm tra thời hạn bảo hành\n(ngay_tao + thoi_gian_bao_hanh tháng >= NOW())

alt Còn trong thời hạn bảo hành
  WC -> DB : INSERT INTO yeu_cau_bao_hanh\n(ma_nguoi_dung, ma_chi_tiet_dh, so_serial,\n mo_ta_su_co, hinh_thuc, so_dien_thoai,\n lich_hen, trang_thai='cho_xu_ly')
  activate DB
  DB --> WC : ma_bao_hanh
  deactivate DB
  WC -> DB : INSERT INTO thong_bao\n(KH: "Phiếu bảo hành #ID đã tiếp nhận")
  WC --> FE : 201 { bao_hanh: { ma_bao_hanh, trang_thai } }
  FE --> KH : ✅ "Yêu cầu bảo hành đã tiếp nhận\nMã phiếu: #BH-XXXX"

else Hết hạn bảo hành
  WC --> FE : 400 { message: "Sản phẩm đã hết thời hạn bảo hành" }
  FE --> KH : ❌ "Sản phẩm đã quá [N] tháng bảo hành"
end
deactivate WC
deactivate FE

== XỬ LÝ BẢO HÀNH (Nhân viên) ==
NV -> FE : Vào Admin → Quản lý Bảo hành
activate FE
FE -> WC : GET /api/admin/warranty?trang_thai=cho_xu_ly\n[JWT Bearer, role=staff|admin]
activate WC
WC -> DB : SELECT ycbh.*, nd.ho_ten, nd.so_dien_thoai,\nsp.ten_san_pham\nFROM yeu_cau_bao_hanh ycbh\nJOIN nguoi_dung nd ON nd.ma_nguoi_dung=ycbh.ma_nguoi_dung\nJOIN chi_tiet_don_hang ctdh ON ...\nJOIN san_pham sp ON ...\nWHERE trang_thai='cho_xu_ly'
activate DB
DB --> WC : Warranty list
deactivate DB
WC --> FE : 200 { warranties }
FE --> NV : Danh sách phiếu bảo hành + hình thức
deactivate WC

NV -> FE : Cập nhật → "Đang xử lý"\n+ ghi chú xử lý
FE -> WC : PATCH /api/admin/warranty/:id/status\n{trang_thai: "dang_xu_ly",\n ma_nhan_vien_xu_ly: nv_id}
activate WC
WC -> DB : UPDATE yeu_cau_bao_hanh\nSET trang_thai='dang_xu_ly',\nma_nhan_vien_xu_ly=?\nWHERE ma_bao_hanh=?
DB --> WC : Updated
WC -> DB : INSERT INTO thong_bao\n(KH: "Phiếu #ID đang được xử lý")
WC --> FE : 200 { warrantyRequest }
FE --> NV : ✅ Đã cập nhật
deactivate WC

NV -> FE : Hoàn thành bảo hành + ghi chú kết quả
activate FE
FE -> WC : PATCH /api/admin/warranty/:id/status\n{trang_thai: "hoan_thanh",\n ghi_chu_xu_ly: "Đã thay linh kiện..."}
activate WC
WC -> DB : UPDATE yeu_cau_bao_hanh\nSET trang_thai='hoan_thanh',\nghi_chu_xu_ly=?,\nngay_hoan_thanh=NOW()\nWHERE ma_bao_hanh=?
DB --> WC : Updated
WC -> DB : INSERT INTO thong_bao\n(KH: "Sản phẩm của bạn đã sửa xong!")
WC --> FE : 200
FE --> NV : ✅ Bảo hành hoàn tất
deactivate WC
deactivate FE

== TÍCH ĐIỂM & SỬ DỤNG ĐIỂM ==
note over KH, DB
  Tích điểm: 1 điểm / 100.000đ giá trị đơn hàng
  Sử dụng: 1 điểm = 1.000đ
  Có thể kết hợp với voucher
end note

KH -> FE : Xem số điểm trên Profile / Header
activate FE
FE -> DB : GET /api/auth/me → diem_tich_luy trong user
activate DB
DB --> FE : { diem_tich_luy: 250 }
deactivate DB
FE --> KH : ⭐ 250 điểm tích lũy (= 250.000đ)
deactivate FE

KH -> FE : Checkout → Nhập số điểm muốn dùng (VD: 100)
activate FE
FE -> FE : Tính: diem_su_dung <= diem_tich_luy\nDeduction = 100 * 1.000 = 100.000đ
FE --> KH : Hiển thị tổng tiền đã giảm

KH -> FE : Xác nhận đặt hàng\n{loyalty_points_used: 100, ...}
FE -> DB : POST /api/orders\n→ orderController xử lý:
activate DB
DB --> FE : Trừ điểm + tính điểm mới
deactivate DB
FE --> KH : ✅ "Đã dùng 100 điểm = -100.000đ\nTích thêm N điểm từ đơn này"
deactivate FE

@enduml
